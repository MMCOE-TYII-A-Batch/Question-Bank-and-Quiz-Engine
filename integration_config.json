{
  "system": {
    "name": "Question Bank and Quiz Engine Platform",
    "version": "1.0.0",
    "environment": "Development / Staging"
  },
  "server": {
    "host": "http://localhost",
    "port": 8080,
    "cors": {
      "allowedOrigins": "*",
      "allowedMethods": "GET, POST, PUT, DELETE, OPTIONS",
      "allowedHeaders": "Content-Type, Authorization"
    }
  },
  "endpoints": {
    "auth": {
      "login": "/api/auth/login",
      "profile": "/api/auth/profile",
      "resetPassword": "/api/auth/reset-password",
      "requestReset": "/api/auth/request-reset"
    },
    "admin": {
      "users": "/api/admin/users"
    },
    "questionBanks": "/api/question-banks",
    "quizzes": "/api/quizzes",
    "quizResults": "/api/quiz-results",
    "auditLogs": "/api/audit-logs",
    "reset": "/api/reset"
  },
  "frontend": {
    "routes": {
      "login": "/login.html",
      "admin": "/admin.html",
      "author": "/author.html",
      "createBank": "/create-question-bank.html",
      "moderator": "/moderator.html",
      "student": "/student.html"
    }
  }
}
